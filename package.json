{
  "name": "jev-vs-jev-pong",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "tsx server/index.ts --production",
    "demo": "node scripts/demo.mjs",
    "test:provider": "tsx scripts/verify-provider.ts",
    "demo:smoke": "node scripts/demo.mjs --smoke",
    "verify": "npm run build && npm test && npm run test:provider && npm run test:luna && npm run test:e2e",
    "demo:luna": "node scripts/demo.mjs --matchup=jev-vs-luna",
    "test:luna": "tsx scripts/verify-luna.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.2",
    "@vitest/browser-playwright": "^4.0.8",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@typesafe-ai/sdk": "0.7.0",
    "dotenv": "^18.0.10",
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  }
}
