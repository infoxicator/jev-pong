# No key? Mock mode is automatic. Force it for recordings/tests:
# JEV_MOCK=1
# Choose one provider. Never prefix keys with VITE_.
# JEV_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-key
# JEV_MODEL=jev-1.13
# Or use Vercel AI Gateway:
# JEV_PROVIDER=vercel
# AI_GATEWAY_API_KEY=your-gateway-key
# JEV_MODEL=typesafe-ai/jev
# JEV_MOCK=0  # fail startup if no real key, instead of automatic mock mode
